<?xml version="1.0" encoding="utf-8"?>
<!--
    Сучасні правила резервного копіювання для Android 14+ (API 34+)
    Підтримка найновіших функцій безпеки та конфіденційності
-->
<full-backup-content>
    <!-- Основні дані з підтримкою end-to-end шифрування -->
    <include domain="database" path="." requireFlags="clientSideEncryption|deviceToDeviceTransfer" />
    <include domain="sharedpref" path="." requireFlags="clientSideEncryption" />
    <include domain="file" path="." />
    
    <!-- Зовнішні файли з урахуванням privacy dashboard -->
    <include domain="external" path="." />

    <!-- Файли з підтримкою selective backup -->
    <include domain="file" path="user_backups/" />
    <include domain="file" path="manual_exports/" />
    <include domain="file" path="sync_data/" requireFlags="clientSideEncryption" />

    <!-- Розширені виключення -->
    <exclude domain="file" path="cache/" />
    <exclude domain="file" path="code_cache/" />
    <exclude domain="file" path="temp/" />
    <exclude domain="file" path="tmp/" />
    <exclude domain="file" path="no_backup/" />
    <exclude domain="file" path="instant-run/" />
    <exclude domain="file" path="profiles/" />
    
    <!-- Виключення файлів діагностики та метрик -->
    <exclude domain="file" path="logs/" />
    <exclude domain="file" path="crash_logs/" />
    <exclude domain="file" path="performance_logs/" />
    <exclude domain="file" path="memory_dumps/" />
    <exclude domain="file" path="telemetry/" />
    <exclude domain="file" path="analytics_cache/" />
    
    <!-- Виключення конфіденційних системних даних -->
    <exclude domain="sharedpref" path="device_fingerprint.xml" />
    <exclude domain="sharedpref" path="hardware_profile.xml" />
    <exclude domain="sharedpref" path="system_analytics.xml" />
    <exclude domain="sharedpref" path="crash_analytics.xml" />
    <exclude domain="sharedpref" path="usage_statistics.xml" />
    <exclude domain="sharedpref" path="advertising_id.xml" />
    
    <!-- Виключення зовнішніх тимчасових та системних файлів -->
    <exclude domain="external" path="Android/data/com.pasich.mynotes/cache/" />
    <exclude domain="external" path="Android/data/com.pasich.mynotes/files/temp/" />
    <exclude domain="external" path="Android/data/com.pasich.mynotes/files/logs/" />
    <exclude domain="external" path="Android/data/com.pasich.mynotes/files/crash_dumps/" />
    
    <!-- Включення користувацьких зовнішніх файлів -->
    <include domain="external" path="MyNotes/" />
    <include domain="external" path="Documents/MyNotes/" />
    <include domain="external" path="Download/MyNotes/" />
    <include domain="external" path="Pictures/MyNotes/" />
</full-backup-content>
