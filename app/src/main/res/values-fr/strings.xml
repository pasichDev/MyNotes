    <!-- Tags Help Section -->
    <string name="help_tags_title">Étiquettes</string>
    <string name="help_tags_create_title">Créer des étiquettes</string>
    <string name="help_tags_create_description">Au début de la liste des étiquettes, appuyez sur le bouton + pour créer une nouvelle étiquette</string>
    <string name="help_tags_edit_title">Modifier les étiquettes</string>
    <string name="help_tags_edit_description">Maintenez une étiquette enfoncée pour ouvrir le menu contextuel d\'édition. Ici, vous pouvez supprimer l\'étiquette, la renommer ou masquer les notes qui lui sont associées.</string>
    <string name="help_tags_hide_title">Masquer les notes</string>
    <string name="help_tags_hide_description">Utilisez la fonction de masquage pour supprimer temporairement les notes étiquetées de la vue principale tout en conservant l\'accès via l\'étiquette</string>
    <string name="help_tags_limit_title">Limite d\'étiquettes</string>
    <string name="help_tags_limit_description">Vous pouvez créer jusqu\'à 25 étiquettes pour une organisation efficace de vos notes</string>
    <string name="help_tags_assign_title">Assigner des étiquettes</string>
    <string name="help_tags_assign_description">Les étiquettes peuvent être assignées aux notes depuis l\'écran principal et lors de l\'édition d\'une note</string>
    <string name="help_tags_update_title">Mise à jour des étiquettes</string>
    <string name="help_tags_update_description">Décrit les mises à jour d\'étiquettes et comment masquer les notes de la vue principale</string>
    
    <!-- Navigation Help Section -->
    <string name="help_navigation_title">Navigation</string>
    <string name="help_navigation_drawer_title">Menu principal</string>
    <string name="help_navigation_drawer_description">Accédez au menu principal en appuyant sur l\'icône hamburger dans le coin supérieur gauche.</string>
    <string name="help_navigation_search_title">Recherche</string>
    <string name="help_navigation_search_description">Utilisez la barre de recherche pour trouver rapidement vos notes par titre ou contenu</string>
    <string name="help_navigation_sort_title">Tri</string>
    <string name="help_navigation_sort_description">Triez vos notes par date de dernière modification ou nom dans l\'ordre croissant ou décroissant</string>
    <string name="help_navigation_format_title">Format d\'affichage</string>
    <string name="help_navigation_format_description">Basculez entre la liste et la grille pour afficher vos notes dans une mise en page qui vous convient</string>
    
    <!-- Navigation Section - Additional -->
    <string name="help_navigation_swipe_title">Gestes de balayage</string>
    <string name="help_navigation_swipe_description">Gérez les notes intuitivement ! Balayez vers la gauche pour activer le mode de sélection multiple pour des opérations en masse rapides, ou vers la droite pour supprimer instantanément une note et l\'envoyer à la corbeille. Les gestes ne sont disponibles qu\'en mode une colonne.</string>
    
    <!-- Other Section -->
    <string name="help_other_title">Autre</string>
    <string name="help_other_security_title">Protection d\'écran</string>
    <string name="help_other_security_description">Lorsqu\'elle est activée dans les paramètres, cette fonction protège vos notes contre la visualisation non autorisée : masque le contenu de l\'application dans l\'aperçu des applications récentes, empêche les captures d\'écran et bloque l\'enregistrement d\'écran. Cette fonction de sécurité s\'active après le redémarrage de l\'application.</string>
    <string name="help_other_shortcuts_title">Raccourcis d\'application</string>
    <string name="help_other_shortcuts_description">Maintenez l\'icône de l\'application enfoncée pour accéder rapidement aux raccourcis de création d\'une nouvelle note ou de recherche dans vos notes. Disponible sur Android 7.1 et plus.</string>
    
    <!-- Help - Notes Features Section -->
    <string name="help_notes_title">Fonctionnalités des notes</string>
    <string name="help_notes_limit_title">Limite de texte</string>
    <string name="help_notes_limit_description">Chaque note peut contenir jusqu\'à 20 000 caractères, offrant amplement d\'espace pour un contenu détaillé.</string>
    <string name="help_notes_translate_title">Traduction</string>
    <string name="help_notes_translate_description">Traduisez vos notes directement dans l\'application. Google Traduction doit être installé sur votre appareil pour utiliser cette fonction.</string>
    <string name="help_notes_text_size_title">Taille du texte</string>
    <string name="help_notes_text_size_description">Ajustez la taille du texte lors de l\'édition de notes à l\'aide de la boîte de dialogue de taille de texte accessible directement depuis l\'écran d\'édition de note.</string>
    <string name="help_notes_copy_title">Modifier la copie</string>
    <string name="help_notes_copy_description">Créez une copie modifiable de n\'importe quelle note pour apporter des modifications tout en gardant l\'original intact.</string>

