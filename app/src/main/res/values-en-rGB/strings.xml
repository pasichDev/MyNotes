    <!-- Help: tasks & reminders -->
    <string name="help_section_icon">Section icon</string>
    <string name="help_feature_icon">Feature icon</string>
    <string name="help_other_title">Other</string>
    <string name="apply">Apply</string>
    <string name="help_tasks_title">Tasks</string>
    <string name="help_tasks_create_title">Creating Tasks</string>
    <string name="help_tasks_create_description">Open Tasks from the main menu. Tap the \"+\" button to add a new task. You can set a title, description, and assign it to a category.</string>
    <string name="help_tasks_categories_title">Categories</string>
    <string name="help_tasks_categories_description">Organise tasks into custom categories. Tap \"Add category\" to create one. Tasks within a category are grouped together for easy management.</string>
    <string name="help_tasks_complete_title">Completing Tasks</string>
    <string name="help_tasks_complete_description">Tap the checkbox next to a task to mark it as done. Completed tasks are grouped at the bottom of the list. Tap again to unmark.</string>
    <string name="help_tasks_reminder_title">Task Reminders</string>
    <string name="help_tasks_reminder_description">Set a reminder for any task by tapping the bell icon. You will receive a notification at the scheduled time. Tap the notification to open the task directly.</string>
    <string name="help_reminders_title">Reminders</string>
    <string name="help_reminders_notes_title">Note Reminders</string>
    <string name="help_reminders_notes_description">Open a note, tap More and choose Reminder. Pick a time using quick options or the date and time picker. The reminder appears at the top of the note; tap it to change it. A notification will appear at the scheduled time.</string>
    <string name="help_reminders_repeat_title">Repeat Options</string>
    <string name="help_reminders_repeat_description">When setting a note reminder, choose how it repeats: Daily, Weekly, Monthly, or Custom… for every few hours, days, weeks, months or years. Each repeat is counted from the time you picked, so a reminder on the 31st rings on the last day of shorter months and is back on the 31st after them. Repeating reminders survive a restart of the phone.</string>
    <string name="help_reminders_interval_title">Interval Notifications</string>
    <string name="help_reminders_interval_description">For repeating reminders, you can enable interval re-notifications every 5, 10, 15, 30, or 60 minutes. The notification will repeat at the chosen interval until the next scheduled occurrence.</string>
    <string name="help_reminders_sound_title">Notification Sound and Volume</string>
    <string name="help_reminders_sound_description">Customise the reminder melody and volume in Settings → Media. Changes apply to all future reminder notifications.</string>


    <!-- Account tab -->
    <string name="tab_account">Account</string>
    <string name="sync_signed_out_title">Not signed in</string>
    <string name="sync_signed_out_description">Sync and Google Drive backup become available after you sign in.</string>
    <string name="sync_unavailable_title">Sync unavailable</string>
    <string name="sync_unavailable_description">Sync and Google Drive backup need Google Play services, which this device does not have.</string>
    <!-- Sync Help Section -->
    <string name="help_sync_title">Synchronisation</string>
    <string name="help_sync_setup_title">Google Drive Sync</string>
    <string name="help_sync_setup_description">Sync is optional. Sign in to your Google account on the Account tab, then tap Sync. Your data remains available on this device when sync is off.</string>
    <string name="help_sync_first_title">First Sync</string>
    <string name="help_sync_first_description">Before the first sync, the app shows how many records will be merged and the estimated upload size. Review the information and confirm to begin.</string>
    <string name="help_sync_data_title">What Is Synced</string>
    <string name="help_sync_data_description">Notes and their attachments, tasks, tags, task categories, and app preferences are synchronised with your Google Drive.</string>
    <string name="help_sync_background_title">Background Sync</string>
    <string name="help_sync_background_description">After you confirm the first sync, you can enable background sync. It runs about every 6 hours when the device has an internet connection and can be turned off at any time.</string>
    <string name="help_sync_conflicts_title">Resolve Conflicts</string>
    <string name="help_sync_conflicts_description">When local and Drive versions differ, choose whether to keep the local version or the version from Google Drive for each conflict.</string>

    <!-- Meet Encly (pasichDev/MyNotes#167) -->
    <string name="meet_encly_title">Meet Encly</string>
    <string name="meet_encly_drawer_subtitle">The successor of My Notes</string>
    <string name="meet_encly_eyebrow">From the author of My Notes</string>
    <string name="meet_encly_promise">Notes that stay encrypted and stay on your phone. No account, no internet.</string>
    <string name="meet_encly_benefit_encrypted">Encrypted, always</string>
    <string name="meet_encly_benefit_encrypted_text">Every note is kept in an encrypted database, and backups are encrypted too.</string>
    <string name="meet_encly_benefit_offline">Offline, no account</string>
    <string name="meet_encly_benefit_offline_text">Encly has no internet permission, so your notes never leave the phone.</string>
    <string name="meet_encly_benefit_lock">PIN and fingerprint lock</string>
    <string name="meet_encly_benefit_lock_text">Only your PIN or fingerprint opens your notes.</string>
    <string name="meet_encly_benefit_open">Free and open source</string>
    <string name="meet_encly_benefit_open_text">Anyone can check the code. Available on Google Play, F-Droid and GitHub.</string>
    <string name="meet_encly_one_way">Moving copies your notes to Encly. Nothing is deleted from My Notes, and Encly never sends anything back.</string>
    <string name="meet_encly_moves_title">Moves to Encly</string>
    <string name="meet_encly_moves_notes">Notes, including the trash</string>
    <string name="meet_encly_moves_tasks">Tasks</string>
    <string name="meet_encly_moves_tags">Tags</string>
    <string name="meet_encly_moves_categories">Task lists</string>
    <string name="meet_encly_moves_categories_note">Become tags in Encly</string>
    <string name="meet_encly_stays_title">Stays in My Notes</string>
    <string name="meet_encly_stays_attachments">Attachments and images</string>
    <string name="meet_encly_stays_attachments_note">Encly does not store files</string>
    <string name="meet_encly_stays_reminders">Reminders</string>
    <string name="meet_encly_stays_reminders_note">Encly has no reminders</string>
    <string name="meet_encly_stays_pinned">Pinned notes</string>
    <string name="meet_encly_stays_pinned_note">They move, but without the pin</string>
    <string name="meet_encly_stays_none">Nothing. Everything you have moves to Encly.</string>
