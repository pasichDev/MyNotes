<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="activity"
            type="com.pasich.mynotes.ui.view.activity.ChangelogActivity" />
    </data>

    <LinearLayout
        android:id="@+id/activity_changelog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        tools:context=".ui.view.activity.ChangelogActivity">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:title="@string/changelog" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Loading indicator -->
            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="visible" />

            <!-- Changelog content -->
            <ScrollView
                android:id="@+id/scroll_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/rounded_card_background"
                        android:padding="20dp"
                        android:layout_marginBottom="16dp"
                        android:elevation="2dp">

                        <TextView
                            android:id="@+id/version_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/whats_new_title"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:gravity="start"
                            tools:text="Version"
                            android:layout_marginBottom="8dp" />


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/whats_new_description"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="14sp"
                            android:lineSpacingExtra="2dp"
                            android:gravity="start"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/changelog_subtitle"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp"
                            android:gravity="start"
                            android:alpha="0.7" />

                    </LinearLayout>

                    <!-- Кнопка "Ознайомився" -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/acknowledge_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="@string/version_acknowledged"
                        android:backgroundTint="?attr/colorPrimary"
                        android:textColor="?attr/colorOnPrimary"
                        app:cornerRadius="12dp" />

                    <!-- Changelog Content -->
                    <TextView
                        android:id="@+id/changelog_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/railway_medium"
                        android:lineSpacingExtra="6dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textIsSelectable="true"
                        android:textSize="15sp"
                        android:paddingBottom="16dp"
                        tools:text="Changelog content will be loaded here..." />

                </LinearLayout>
            </ScrollView>

            <!-- Error layout -->
            <LinearLayout
                android:id="@+id/error_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginBottom="16dp"
                    android:alpha="0.6"
                    android:contentDescription="ErroNetwork"
                    android:src="@drawable/ic_wifi_off"
                    app:tint="?attr/colorOnBackground"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/railway_medium"
                    android:text="@string/errorLoadingChangelog"
                    android:textAlignment="center"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:text="@string/checkInternetConnection"
                    android:textAlignment="center"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/retryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/retry"
                    app:icon="@drawable/ic_refresh" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>
</layout>
