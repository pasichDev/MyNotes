<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="20dp"
    android:paddingVertical="18dp"
    android:background="@drawable/item_theme_selector_background">

    <ImageView
        android:id="@+id/themeModeIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        app:tint="?attr/colorPrimary" />

    <TextView
        android:id="@+id/themeModeName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="16sp"
        android:textColor="?attr/colorOnSurface"
        android:fontFamily="@font/railway_medium"
        android:text="Theme Mode Name"
        android:layout_marginEnd="16dp" />

    <ImageView
        android:id="@+id/selectedModeIndicator"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_check_circle"
        android:visibility="gone"
        app:tint="?attr/colorPrimary" />

</LinearLayout>
