<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="tag"
            type="com.pasich.mynotes.data.model.Tag" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="4dp"
        app:cardElevation="2dp"
        app:cardCornerRadius="12dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:minHeight="64dp">

            <!-- Tag Icon/Add Icon -->
            <ImageView
                android:id="@+id/tag_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                app:visibilityForAddTag="@{tag}"
                android:src="@drawable/ic_add"
                app:tint="?attr/colorPrimary" />

            <ImageView
                android:id="@+id/tag_icon_normal"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                app:visibilityForNonAddTag="@{tag}"
                android:src="@drawable/ic_tag"
                app:tint="?attr/colorOnSurfaceVariant" />

            <!-- Tag Content -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Tag Name -->
                <TextView
                    android:id="@+id/tag_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:tagDisplayName="@{tag}"
                    android:textSize="16sp"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="normal"
                    android:singleLine="true"
                    android:ellipsize="end"
                    tools:text="Work" />

                <!-- Tag Info (only for "Add Tag" item) -->
                <TextView
                    android:id="@+id/tag_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    app:visibilityForAddTag="@{tag}"
                    android:text="@string/create_first_tag"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:singleLine="true"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- Visibility Indicator (only for regular tags) -->
            <ImageView
                android:id="@+id/visibility_indicator"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                app:visibilityForNonAddTag="@{tag}"
                android:src="@{tag.visibility == 0 ? @drawable/ic_show : @drawable/ic_hide}"
                app:tint="?attr/colorOnSurfaceVariant"
                android:alpha="0.7" />

            <!-- Options Button (only for regular tags) -->
            <ImageButton
                android:id="@+id/options_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                app:visibilityForNonAddTag="@{tag}"
                android:src="@drawable/ic_more"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="@string/tag_options" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</layout>