<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="activity"
            type="com.pasich.mynotes.ui.view.activity.AboutActivity" />
    </data>

    <LinearLayout
        android:id="@+id/activity_about"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        tools:context=".ui.view.activity.AboutActivity">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:title="@string/aboutApps" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="16dp"

                    android:layout_marginHorizontal="20dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp">


                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@mipmap/ic_launcher"
                        app:shapeAppearanceOverlay="@style/rounderIconApp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="18sp"
                            android:text="@string/app_name" />

                        <TextView
                            android:id="@+id/versionApp"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:paddingVertical="2dp"
                            android:text="@string/developer"
                            android:textColor="?attr/colorOutline"
                            android:textSize="14sp" />
                    </LinearLayout>


                </LinearLayout>    </com.google.android.material.card.MaterialCardView>


                <LinearLayout
                    android:id="@+id/shareApp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_item_start"
                    android:layout_marginHorizontal="20dp"
                    android:onClick="@{()-> activity.shareApp()}"
                    android:orientation="horizontal"
                    android:padding="@dimen/paddingItems">

                    <ImageView
                        style="@style/iconActivityList"
                        android:contentDescription="@string/shareApp"
                        android:src="@drawable/ic_share_app" />

                    <TextView
                        style="@style/itemTextBottomSheets"
                        android:text="@string/shareApp" />
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/feedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_item_end"
                    android:layout_marginHorizontal="20dp"
                    android:onClick="@{()-> activity.sendFeedback()}"
                    android:orientation="horizontal"
                    android:padding="@dimen/paddingItems">

                    <ImageView
                        style="@style/iconActivityList"
                        android:contentDescription="@string/leaveFeedback"
                        android:src="@drawable/ic_feedback" />

                    <TextView
                        style="@style/itemTextBottomSheets"
                        android:text="@string/leaveFeedback" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="20dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_item_start"
                    android:layout_marginHorizontal="20dp"
                    android:onClick="@{()-> activity.githubRepo()}"
                    android:orientation="horizontal"
                    android:padding="@dimen/paddingItems">

                    <ImageView
                        style="@style/iconActivityList"
                        android:contentDescription="Github Repo"
                        android:src="@drawable/ic_github_repo"
                        tools:ignore="HardcodedText" />

                    <TextView
                        style="@style/itemTextBottomSheets"
                        android:text="Github Repo"
                        tools:ignore="HardcodedText" />
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />
                <LinearLayout
                    android:id="@+id/privacyApp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_item_middle"
                    android:layout_marginHorizontal="20dp"
                    android:onClick="@{()-> activity.policyOpen()}"
                    android:orientation="horizontal"
                    android:padding="@dimen/paddingItems">

                    <ImageView
                        style="@style/iconActivityList"
                        android:contentDescription="@string/privacyApp"
                        android:src="@drawable/ic_policy" />

                    <TextView
                        style="@style/itemTextBottomSheets"
                        android:text="@string/privacyApp" />
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />
                <LinearLayout
                    android:id="@+id/changelogApp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_item_end"
                    android:layout_marginHorizontal="20dp"
                    android:onClick="@{()-> activity.openChangelog()}"
                    android:orientation="horizontal"
                    android:padding="@dimen/paddingItems">

                    <ImageView
                        style="@style/iconActivityList"
                        android:contentDescription="@string/changelog"
                        android:src="@drawable/ic_history" />

                    <TextView
                        style="@style/itemTextBottomSheets"
                        android:text="@string/changelog" />
                </LinearLayout>



            </LinearLayout>

        </ScrollView>
    </LinearLayout>

</layout>