<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
    app:strokeWidth="0dp"
    app:shapeAppearanceOverlay="@style/ShapeAppearance.BottomBar">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <!-- LEFT: selected count -->
        <TextView
            android:id="@+id/selectedCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="3 selected"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />

        <!-- RIGHT: actions -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Change tag -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_tag_change"
                style="@style/Widget.IconButton"
                app:icon="@drawable/ic_tag"
                android:contentDescription="@string/tag_options" />

            <!-- Share -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_share"
                style="@style/Widget.IconButton"
                app:icon="@drawable/ic_share"
                android:contentDescription="@string/share" />

            <!-- Restore -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_restore"
                style="@style/Widget.IconButton"
                android:visibility="gone"
                app:icon="@drawable/ic_restore_trash"
                android:contentDescription="@string/restore" />

            <!-- Delete -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_delete"
                style="@style/Widget.IconButton"
                app:icon="@drawable/ic_delete_note"
                android:contentDescription="@string/delete" />

            <!-- Close -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_close"
                style="@style/IconButtonEnd"
                app:icon="@drawable/ic_close_search_view"
                android:contentDescription="@string/close" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
