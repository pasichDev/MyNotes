<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="Note"
            type="com.pasich.mynotes.data.model.Note" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/item_Note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:backgroundTint="?attr/colorSurfaceContainer"
        android:padding="10dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/nameNote"
                style="@style/itemNoteTitle"
                android:text="@{Note.title}"
                android:visibility="@{Note.title.length() >= 1 ? View.VISIBLE : View.GONE }"
                tools:text="Title Note" />

            <TextView
                android:id="@+id/previewNote"
                style="@style/itemNotePreview"
                android:maxLines="2"
                android:text="@{Note.valuePreview}"
                tools:text="Preview Note Check" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dataNote"
                    style="@style/itemNotePreview"
                    android:alpha="0.7"
                    android:maxLines="1"
                    app:dataNote="@{Note}"
                    tools:text="01.01.2025" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="0dp"
                    android:visibility="@{Note.hasRichContent() ? View.VISIBLE : View.GONE }"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:cardElevation="0dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small"
                    app:strokeWidth="0dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="Extended Editor"
                        android:textColor="@color/chip_text_alpha"
                        android:textSize="12sp"
                        tools:ignore="HardcodedText" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
