<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="android.view.View" />

        <variable
            name="presenter"
            type="com.pasich.mynotes.ui.presenter.BackupPresenter" />

        <variable
            name="isAuthUser"
            type="boolean" />

        <variable
            name="isPlayService"
            type="boolean" />

        <variable
            name="isVisibleProgressCloud"
            type="boolean" />

    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Local Backup Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Section Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/iconActivityListBackup"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="0dp"
                            android:contentDescription="@string/backup"
                            android:src="@drawable/ic_backup_restore"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/backup"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="15dp"
                        android:lineSpacingMultiplier="1.2"
                        android:text="@string/backup_descrpt"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="10dp" />


                    <!-- Local Backup Actions -->
                    <LinearLayout
                        android:id="@+id/exportLocal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_item_start"
                        android:onClick="@{(view) -> presenter.saveBackupPresenter(true)}"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp">

                        <ImageView
                            style="@style/iconActivityListBackup"
                            android:contentDescription="@string/exportLocalBackup"
                            android:src="@drawable/ic_export" />

                        <TextView
                            style="@style/itemTextBottomSheets"
                            android:text="@string/exportLocalBackup" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:id="@+id/importLocal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_item_end"
                        android:onClick="@{(view) -> presenter.restoreBackupPresenter(true)}"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp">

                        <ImageView
                            style="@style/iconActivityListBackup"
                            android:contentDescription="@string/importLocalBackup"
                            android:src="@drawable/ic_import" />

                        <TextView
                            style="@style/itemTextBottomSheets"
                            android:text="@string/importLocalBackup" />
                    </LinearLayout>


                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Data Export Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Section Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/iconActivityListBackup"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="0dp"
                            android:contentDescription="@string/dataExport"
                            android:src="@drawable/ic_export"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dataExport"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Description -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="16dp"
                        android:lineSpacingMultiplier="1.2"
                        android:text="@string/dataExportDescription"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp" />

                    <!-- Export Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/exportAllNotes"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:backgroundTint="?attr/colorPrimary"
                        android:onClick="@{(view) -> presenter.exportAllNotesPresenter()}"
                        android:paddingHorizontal="16dp"
                        android:text="@string/exportAllNotes"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnPrimary"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="@android:color/white" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</layout>