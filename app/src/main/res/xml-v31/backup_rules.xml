<?xml version="1.0" encoding="utf-8"?>
<!--
    Розширені правила резервного копіювання для Android 12+ (API 31+)
    Включає підтримку нових функцій резервного копіювання
-->
<full-backup-content>
    <!-- Основні дані додатку -->
    <include domain="database" />
    <include domain="sharedpref" />
    <include domain="file" />
    
    <!-- Зовнішні файли з підтримкою scoped storage -->
    <include domain="external" />
    
    <!-- Спеціальні включення для нотаток -->
    <include domain="file" path="exports/" />
    
    <!-- Включення налаштувань -->
    <include domain="sharedpref" path="com.pasich.mynotes_preferences.xml" />
    
    <!-- Виключення системних та тимчасових файлів -->
    <exclude domain="file" path="cache/" />
    <exclude domain="file" path="code_cache/" />
    <exclude domain="file" path="temp/" />
    <exclude domain="file" path="tmp/" />
    <exclude domain="file" path="no_backup/" />
    <exclude domain="file" path="instant-run/" />
    
    <!-- Виключення файлів логів та діагностики -->
    <exclude domain="file" path="logs/" />
    <exclude domain="file" path="crash_logs/" />
    <exclude domain="file" path="error_reports/" />
    <exclude domain="file" path="performance_logs/" />
    
    <!-- Виключення конфіденційних даних -->
    <exclude domain="sharedpref" path="device_id.xml" />
    <exclude domain="sharedpref" path="installation_id.xml" />
    <exclude domain="sharedpref" path="analytics.xml" />
    <exclude domain="sharedpref" path="firebase_analytics.xml" />
    <exclude domain="sharedpref" path="crashlytics.xml" />
    
    <!-- Виключення зовнішніх тимчасових файлів -->
    <exclude domain="external" path="Android/data/com.pasich.mynotes/cache/" />
    <exclude domain="external" path="Android/data/com.pasich.mynotes/files/temp/" />
    <exclude domain="external" path="Android/data/com.pasich.mynotes/files/logs/" />
</full-backup-content>
