    <!-- Developer Support -->
    <string name="support_solo_developer_title">Підтримати розробника</string>
    <string name="support_solo_developer_description">Привіт! Я розробник, який працює над MyNotes у вільний час. Усі функції завжди будуть безкоштовними, але ваша підтримка допомагає мені приділяти більше часу для покращення цього додатку. Кожен внесок означає для мене цілий світ! 💖</string>

    <!-- Help Activity -->
    <string name="help_title">Довідка</string>
    <string name="help_subtitle">Дізнайтеся, як максимально використовувати функції MyNotes</string>
    <string name="help_section_icon">Іконка розділу</string>
