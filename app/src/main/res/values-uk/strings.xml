    <!-- Tags Help Section -->
    <string name="help_tags_title">Теги</string>
    <string name="help_tags_func_title">Взаємодія з тегами</string>
    <string name="help_tags_func_description">У розділі Теги ви можете створювати та редагувати теги. Також тут можна керувати порядком тегів — просто перетягніть їх, щоб змінити сортування. Це дозволяє ефективно організовувати ваші теги.</string>
    <string name="help_tags_edit_title">Редагування тегів</string>
    <string name="help_tags_edit_description">Утримуйте тег, щоб відкрити контекстне меню редагування. Тут ви можете видалити тег, перейменувати його або приховати нотатки, пов’язані з ним.</string>
    <string name="help_tags_hide_title">Приховування нотаток</string>
    <string name="help_tags_hide_description">Використовуйте функцію приховування, щоб тимчасово видалити позначені нотатки з головного виду, зберігаючи доступ до них через тег</string>
    <string name="help_tags_limit_title">Обмеження тегів</string>
    <string name="help_tags_limit_description">Можна створити не більше 25 тегів для ефективної організації ваших нотаток</string>

    <!-- Navigation Help Section -->
    <string name="help_navigation_title">Навігація</string>
    <string name="help_navigation_drawer_title">Головне меню</string>
    <string name="help_navigation_drawer_description">Отримайте доступ до головного меню, натиснувши іконку бургера у верхньому лівому куті.</string>
    <string name="help_navigation_search_title">Пошук</string>
    <string name="help_navigation_search_description">Використовуйте панель пошуку для швидкого знаходження ваших нотаток за назвою або змістом</string>
    <string name="help_navigation_sort_title">Сортування</string>
    <string name="help_navigation_sort_description">Сортуйте ваші нотатки за датою останньої зміни або назвою у висхідному чи спадному порядку</string>
    <string name="help_navigation_format_title">Формат відображення</string>
    <string name="help_navigation_format_description">Переключайтеся між списком та сіткою для відображення ваших нотаток у зручному для вас макеті</string>

    <!-- Navigation Section - Additional -->
    <string name="help_navigation_swipe_title">Жести свайп</string>
    <string name="help_navigation_swipe_description">Керуйте нотатками інтуїтивно! Проведіть пальцем ліворуч, щоб увімкнути режим вибору кількох нотаток для швидких масових операцій, або вправо — щоб миттєво видалити нотатку та відправити її в кошик. Жести доступні лише в одноколонковому режимі.</string>

    <!-- Sync Help Section -->
    <string name="help_sync_title">Синхронізація</string>
    <string name="help_sync_setup_title">Синхронізація з Google Drive</string>
    <string name="help_sync_setup_description">Синхронізація необов’язкова. Увійдіть у Google-акаунт на вкладці «Акаунт», а потім натисніть «Синхронізувати». Коли синхронізацію вимкнено, дані залишаються доступними на цьому пристрої.</string>
    <string name="help_sync_first_title">Перша синхронізація</string>
    <string name="help_sync_first_description">Перед першою синхронізацією додаток покаже кількість записів для об’єднання й орієнтовний розмір вивантаження. Перевірте інформацію та підтвердьте запуск.</string>
    <string name="help_sync_data_title">Що синхронізується</string>
    <string name="help_sync_data_description">З Google Drive синхронізуються нотатки та їхні вкладення, завдання, теги, категорії завдань і налаштування додатку.</string>
    <string name="help_sync_background_title">Фонова синхронізація</string>
    <string name="help_sync_background_description">Після підтвердження першої синхронізації можна увімкнути фонову. Вона запускається приблизно кожні 6 годин за наявності інтернету, і її можна вимкнути будь-коли.</string>
    <string name="help_sync_conflicts_title">Вирішення конфліктів</string>
    <string name="help_sync_conflicts_description">Коли локальна версія та версія на Drive відрізняються, для кожного конфлікту виберіть, яку з них зберегти: локальну чи з Google Drive.</string>

    <!-- Help - Notes Features Section -->
    <string name="help_notes_title">Функції нотаток</string>
    <string name="help_notes_limit_title">Обмеження тексту</string>
    <string name="help_notes_limit_description">Кожна нотатка може містити до 20,000 символів, що забезпечує достатньо місця для детального контенту.</string>
    <string name="help_notes_translate_title">Переклад</string>
    <string name="help_notes_translate_description">Перекладайте ваші нотатки прямо в додатку. Для використання цієї функції на вашому пристрої повинен бути встановлений Google Перекладач.</string>
    <string name="help_notes_text_size_title">Розмір тексту</string>
    <string name="help_notes_text_size_description">Змінюйте розмір тексту під час редагування нотаток за допомогою діалогового вікна розміру тексту, доступного прямо з екрану редагування нотатки.</string>
    <string name="help_notes_copy_title">Редагувати копію</string>
    <string name="help_notes_copy_description">Створюйте редаговану копію будь-якої нотатки для внесення змін, зберігаючи оригінал недоторканим.</string>

    <!-- Share and Export Help -->
    <string name="help_notes_share_title">Поділитися та експорт нотаток</string>
    <string name="help_notes_share_description">Діліться однією або кількома нотатками через інші додатки, зберігайте на Google Drive або експортуйте як TXT, PDF чи HTML файли зі стилізованим форматуванням.</string>

    <string name="actual_version">Актуально для версії %1$s</string>

    <!-- Other Section -->
    <string name="help_other_title">Інше</string>
    <string name="help_other_security_title">Захист екрану</string>
    <string name="help_other_security_description">Коли увімкнено в налаштуваннях, ця функція захищає ваші нотатки від несанкціонованого перегляду, приховуючи вміст додатку в огляді останніх програм, запобігаючи скріншотам та блокуючи запис екрану. Ця функція безпеки активується після перезапуску додатку.</string>
    <string name="help_other_shortcuts_title">Швидкі дії</string>
    <string name="help_other_shortcuts_description">Утримуйте іконку додатку для швидкого доступу до створення нової нотатки або пошуку серед ваших нотаток. Доступно на Android 7.1 і вище.</string>

    <!-- Backup and Export Help -->
    <string name="help_other_backup_export_title">Синхронізація та експорт даних</string>
    <string name="help_other_backup_export_description">У розділі "Синхронізація та резервні копії" ви можете експортувати всі свої нотатки в різних форматах (TXT, PDF, HTML) для перегляду та створення резервних копій.</string>

    <!-- App Shortcuts -->
    <string name="shortcut_new_note_short">Нова нотатка</string>
    <string name="shortcut_new_note_long">Створити нову нотатку</string>
    <string name="shortcut_search_short">Пошук</string>
    <string name="shortcut_search_long">Пошук у нотатках</string>
    <string name="shortcut_disabled_message">Ця функція недоступна</string>

    <string name="saveStatus">Статус збереження</string>
    <string name="saveStatusSaved">Збережено</string>
    <string name="saveStatusPending">Незбережені зміни</string>
    <string name="saveStatusSaving">Збереження…</string>
    <string name="saveStatusError">Помилка збереження</string>
    <string name="help_notes_autosave_title">Автозбереження</string>
    <string name="help_notes_autosave_description">Нотатки автоматично зберігаються через 2 секунди після завершення вводу. У верхній панелі відображається індикатор: синя крапка — незбережені зміни, анімована іконка — процес збереження, зелена галочка — успішно збережено. Навіть якщо ви закриєте додаток або він аварійно завершиться, останні зміни не буде втрачено.</string>

    <!-- Tasks Help Section -->
    <string name="help_tasks_title">Завдання</string>
    <string name="help_tasks_create_title">Створення завдань</string>
    <string name="help_tasks_create_description">Відкрийте Завдання з головного меню. Натисніть «+», щоб додати нове завдання. Можна вказати назву, опис і призначити категорію.</string>
    <string name="help_tasks_categories_title">Категорії</string>
    <string name="help_tasks_categories_description">Організовуйте завдання за власними категоріями. Натисніть «Додати категорію», щоб створити нову. Завдання категорії групуються разом для зручного керування.</string>
    <string name="help_tasks_complete_title">Виконання завдань</string>
    <string name="help_tasks_complete_description">Натисніть на прапорець біля завдання, щоб позначити його як виконане. Виконані завдання групуються внизу списку. Натисніть ще раз, щоб скасувати позначення.</string>
    <string name="help_tasks_reminder_title">Нагадування для завдань</string>
    <string name="help_tasks_reminder_description">Встановіть нагадування для будь-якого завдання через іконку дзвіночка. Ви отримаєте сповіщення у вказаний час. Натисніть на сповіщення, щоб відкрити завдання.</string>

    <!-- Reminders Help Section -->
    <string name="help_reminders_title">Нагадування</string>
    <string name="help_reminders_notes_title">Нагадування для нотаток</string>
    <string name="help_reminders_notes_description">Відкрийте будь-яку нотатку та натисніть іконку дзвіночка, щоб встановити нагадування. Виберіть час за допомогою швидких варіантів або вручну. Сповіщення з\'явиться у вказаний час.</string>
    <string name="help_reminders_repeat_title">Параметри повторення</string>
    <string name="help_reminders_repeat_description">При встановленні нагадування для нотатки увімкніть перемикач «Повторення», щоб вибрати цикл: щодня, щотижня або щомісяця. Нагадування автоматично переноситься після кожного спрацювання.</string>
    <string name="help_reminders_interval_title">Інтервальні сповіщення</string>
    <string name="help_reminders_interval_description">Для повторюваних нагадувань можна увімкнути інтервальне повторення кожні 5, 10, 15, 30 або 60 хвилин. Сповіщення повторюватиметься через вибраний інтервал до наступного запланованого часу.</string>
    <string name="help_reminders_sound_title">Звук і гучність сповіщень</string>
    <string name="help_reminders_sound_description">Налаштуйте мелодію та гучність нагадувань у Налаштуваннях → Медіа. Зміни застосовуються до всіх майбутніх сповіщень.</string>

