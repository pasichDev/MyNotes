    <!-- Help: tasks & reminders -->
    <string name="apply">Қолдану</string>
    <string name="help_tasks_title">Тапсырмалар</string>
    <string name="help_tasks_create_title">Тапсырма құру</string>
    <string name="help_tasks_create_description">Негізгі мәзірден «Тапсырмалар» бөлімін ашыңыз. Жаңа тапсырма қосу үшін \"+\" түймесін басыңыз. Атауын, сипаттамасын көрсетіп, санатқа тағайындай аласыз.</string>
    <string name="help_tasks_categories_title">Санаттар</string>
    <string name="help_tasks_categories_description">Тапсырмаларды өз санаттарыңызға бөліңіз. Санат жасау үшін «Санат қосу» түймесін басыңыз. Бір санаттағы тапсырмалар бірге топталады — оларды басқару оңай.</string>
    <string name="help_tasks_complete_title">Тапсырманы аяқтау</string>
    <string name="help_tasks_complete_description">Тапсырманы орындалды деп белгілеу үшін жанындағы құсбелгіні басыңыз. Орындалған тапсырмалар тізімнің төменгі жағына жиналады. Белгіні алу үшін қайта басыңыз.</string>
    <string name="help_tasks_reminder_title">Тапсырма еске салғыштары</string>
    <string name="help_tasks_reminder_description">Қоңырау белгішесін басып, кез келген тапсырмаға еске салғыш қойыңыз. Белгіленген уақытта хабарландыру келеді. Тапсырманы бірден ашу үшін хабарландыруды басыңыз.</string>
    <string name="help_reminders_title">Еске салғыштар</string>
    <string name="help_reminders_notes_title">Жазба еске салғыштары</string>
    <string name="help_reminders_notes_description">Жазбаны ашып, «Қосымша» түймесін басып, «Еске салу» тармағын таңдаңыз. Уақытты жылдам нұсқалар арқылы немесе күн мен уақытты таңдау терезесінен көрсетіңіз. Еске салу жазбаның жоғарғы жағында көрсетіледі, өзгерту үшін оны басыңыз. Белгіленген уақытта хабарландыру шығады.</string>
    <string name="help_reminders_repeat_title">Қайталау параметрлері</string>
    <string name="help_reminders_repeat_description">Жазбаға еске салғыш қойғанда оның қалай қайталанатынын таңдаңыз: күн сайын, апта сайын, ай сайын немесе «Басқаша…» — бірнеше сағат, күн, апта, ай не жыл сайын. Әр қайталау таңдалған уақыттан бастап саналады, сондықтан айдың 31-іне қойылған еске салғыш қысқа айларда соңғы күні, кейін қайтадан 31-інде келеді. Қайталанатын еске салғыштар телефон қайта іске қосылғаннан кейін де сақталады.</string>
    <string name="help_reminders_interval_title">Аралық хабарландырулар</string>
    <string name="help_reminders_interval_description">Қайталанатын еске салғыштар үшін әр 5, 10, 15, 30 немесе 60 минут сайын қайта хабарлауды қосуға болады. Хабарландыру келесі жоспарланған уақытқа дейін таңдалған аралықпен қайталанады.</string>
    <string name="help_reminders_sound_title">Хабарландыру дыбысы мен қаттылығы</string>
    <string name="help_reminders_sound_description">Еске салғыш әуені мен дыбыс қаттылығын «Параметрлер → Медиа» бөлімінде реттеңіз. Өзгерістер барлық болашақ хабарландыруларға қолданылады.</string>


    <!-- Account tab -->
    <string name="tab_account">Есептік жазба</string>
    <string name="sync_signed_out_title">Сіз кірмегенсіз</string>
    <string name="sync_signed_out_description">Синхрондау және Google Дискідегі көшірме кіргеннен кейін қолжетімді.</string>
    <string name="sync_unavailable_title">Синхрондау қолжетімсіз</string>
    <string name="sync_unavailable_description">Синхрондау және Google Дискідегі көшірме бұл құрылғыда жоқ Google Play қызметтерін қажет етеді.</string>
    <!-- Sync Help Section -->
    <string name="help_sync_title">Синхрондау</string>
    <string name="help_sync_setup_title">Google Drive-пен синхрондау</string>
    <string name="help_sync_setup_description">Синхрондау міндетті емес. «Есептік жазба» қойындысында Google есептік жазбаңызға кіріп, «Синхрондау» түймесін түртіңіз. Синхрондау өшірілген кезде деректер осы құрылғыда қолжетімді болып қалады.</string>
    <string name="help_sync_first_title">Алғашқы синхрондау</string>
    <string name="help_sync_first_description">Алғашқы синхрондаудың алдында қолданба біріктірілетін жазбалар санын және жүктеудің болжамды көлемін көрсетеді. Ақпаратты тексеріп, бастау үшін растаңыз.</string>
    <string name="help_sync_data_title">Не синхрондалады</string>
    <string name="help_sync_data_description">Жазбалар мен олардың тіркемелері, тапсырмалар, тегтер, тапсырма санаттары және қолданба баптаулары Google Drive-пен синхрондалады.</string>
    <string name="help_sync_background_title">Фондық синхрондау</string>
    <string name="help_sync_background_description">Алғашқы синхрондауды растағаннан кейін фондық синхрондауды қоса аласыз. Ол құрылғы интернетке қосылған кезде шамамен әр 6 сағат сайын орындалады және оны кез келген уақытта өшіруге болады.</string>
    <string name="help_sync_conflicts_title">Қайшылықтарды шешу</string>
    <string name="help_sync_conflicts_description">Жергілікті және Drive нұсқалары әртүрлі болса, әр қайшылық үшін жергілікті нұсқаны не Google Drive нұсқасын сақтауды таңдаңыз.</string>

    <!-- Meet Encly (pasichDev/MyNotes#167) -->
    <string name="meet_encly_title">Encly-мен танысыңыз</string>
    <string name="meet_encly_drawer_subtitle">«Менің жазбаларым» қолданбасының мұрагері</string>
    <string name="meet_encly_intro">Encly — «Менің жазбаларым» авторының жаңа қолданбасы: офлайн жұмыс істейтін толық шифрланған жазбалар. Жазбалар шифрланған дерекқорда сақталады, қолданба PIN-кодпен құлыпталады, ал сақтық көшірмелер де шифрланған.</string>
    <string name="meet_encly_one_way">Көшіру бір бағытта жүреді: «Менің жазбаларым» деректеріңізді Encly-ге береді, ал Encly ешнәрсені кері жібермейді. «Менің жазбаларым» қолданбасынан ештеңе жойылмайды, ол бұрынғыдай жұмыс істей береді.</string>
    <string name="meet_encly_moves_title">Не көшіріледі</string>
    <string name="meet_encly_moves_notes">Жазбалар, себетті қоса: %1$d</string>
    <string name="meet_encly_moves_tasks">Тапсырмалар: %1$d</string>
    <string name="meet_encly_moves_tags">Тегтер: %1$d</string>
    <string name="meet_encly_moves_categories">Тапсырмалар тізімдері (тегке айналады): %1$d</string>
    <string name="meet_encly_stays_title">Не көшірілмейді</string>
    <string name="meet_encly_stays_attachments">Тіркемелер мен суреттер: %1$d. Олар «Менің жазбаларым» қолданбасында қалады.</string>
    <string name="meet_encly_stays_reminders">Еске салғыштар: %1$d. Encly-де еске салғыштар жоқ.</string>
    <string name="meet_encly_stays_pinned">Бекітілген жазбалар: %1$d. Олар көшіріледі, бірақ бекітусіз.</string>
    <string name="meet_encly_get">Encly алу</string>
    <string name="meet_encly_update">Encly жаңарту</string>
    <string name="meet_encly_needs_update">Орнатылған Encly нұсқасы әзірге жазбаларды қабылдай алмайды. Оны соңғы нұсқаға дейін жаңартып, осында қайта оралыңыз.</string>
    <string name="meet_encly_untrusted">Encly деп аталатын орнатылған қолданба ресми нұсқа емес, сондықтан жазбаларыңыз оған жіберілмейді. Encly-ді Google Play, F-Droid немесе GitHub арқылы орнатыңыз.</string>
    <string name="meet_encly_move">Жазбаларымды Encly-ге көшіру</string>
    <string name="meet_encly_result_ok">Encly деректеріңізді алды. Жазбалар: %1$d, тапсырмалар: %2$d, тегтер: %3$d. Өткізіліп жіберілді: %4$d.</string>
    <string name="meet_encly_result_attachments">«Менің жазбаларым» қолданбасында қалған тіркемелер мен суреттер: %1$d.</string>
    <string name="meet_encly_result_cancelled">Көшіру тоқтатылды. Ештеңе өзгерген жоқ.</string>
    <string name="meet_encly_result_untrusted">Encly жазбаларды тек ресми «Менің жазбаларым» қолданбасынан қабылдайды. «Менің жазбаларым» қолданбасын Google Play, F-Droid немесе GitHub арқылы орнатып, қайталап көріңіз.</string>
    <string name="meet_encly_result_unsupported">Бұл Encly нұсқасы «Менің жазбаларым» қолданбасының осы нұсқасының деректерін оқи алмайды. Encly-ді жаңартып, қайталап көріңіз.</string>
    <string name="meet_encly_result_invalid">Encly деректерді оқи алмады. Ештеңе импортталған жоқ.</string>
    <string name="meet_encly_result_too_large">Бір реттік көшіру үшін деректер тым көп. Ештеңе импортталған жоқ.</string>
    <string name="meet_encly_result_failed">Encly импортты аяқтай алмады. «Менің жазбаларым» қолданбасынан ештеңе жойылған жоқ.</string>
    <string name="meet_encly_error_prepare">Жазбаларды Encly үшін дайындау мүмкін болмады.</string>
    <string name="meet_encly_clear_hint">Жазбаларыңыз енді Encly-де. «Менің жазбаларым» әлі де өз көшірмесін сақтайды. Ол қажет болмаса, оны тазалауға болады.</string>
    <string name="meet_encly_clear">«Менің жазбаларым» тазалау</string>
    <string name="meet_encly_clear_confirm_title">«Менің жазбаларым» тазаланбақ па?</string>
    <string name="meet_encly_clear_confirm_message">Бұл «Менің жазбаларым» қолданбасынан барлық жазбаларды (себетті қоса), тапсырмаларды, тегтерді, тапсырмалар тізімдерін және тіркеме файлдарын біржола жояды. Google Drive синхрондауы қосулы болса, олар синхрондалған көшірмеден де жойылады. Тіркемелер Encly-ге көшірілген жоқ. Бұл әрекетті болдырмау мүмкін емес.</string>
    <string name="meet_encly_clear_confirm">Барлығын жою</string>
    <string name="meet_encly_cleared">«Менің жазбаларым» тазаланды.</string>
    <string name="meet_encly_clear_failed">«Менің жазбаларым» тазалау мүмкін болмады.</string>
    <string name="meet_encly_dialog_text">«Менің жазбаларым» қолданбасының мұрагері бар — Encly, офлайн жұмыс істейтін толық шифрланған жазбалар. Барлық жазбаларыңызды оған бір түртумен көшіруге болады.</string>
