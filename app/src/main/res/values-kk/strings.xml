    <!-- Help: tasks & reminders -->
    <string name="apply">Қолдану</string>
    <string name="help_tasks_title">Тапсырмалар</string>
    <string name="help_tasks_create_title">Тапсырма құру</string>
    <string name="help_tasks_create_description">Негізгі мәзірден «Тапсырмалар» бөлімін ашыңыз. Жаңа тапсырма қосу үшін \"+\" түймесін басыңыз. Атауын, сипаттамасын көрсетіп, санатқа тағайындай аласыз.</string>
    <string name="help_tasks_categories_title">Санаттар</string>
    <string name="help_tasks_categories_description">Тапсырмаларды өз санаттарыңызға бөліңіз. Санат жасау үшін «Санат қосу» түймесін басыңыз. Бір санаттағы тапсырмалар бірге топталады — оларды басқару оңай.</string>
    <string name="help_tasks_complete_title">Тапсырманы аяқтау</string>
    <string name="help_tasks_complete_description">Тапсырманы орындалды деп белгілеу үшін жанындағы құсбелгіні басыңыз. Орындалған тапсырмалар тізімнің төменгі жағына жиналады. Белгіні алу үшін қайта басыңыз.</string>
    <string name="help_tasks_reminder_title">Тапсырма еске салғыштары</string>
    <string name="help_tasks_reminder_description">Қоңырау белгішесін басып, кез келген тапсырмаға еске салғыш қойыңыз. Белгіленген уақытта хабарландыру келеді. Тапсырманы бірден ашу үшін хабарландыруды басыңыз.</string>
    <string name="help_reminders_title">Еске салғыштар</string>
    <string name="help_reminders_notes_title">Жазба еске салғыштары</string>
    <string name="help_reminders_notes_description">Кез келген жазбаны ашып, еске салғыш қою үшін қоңырау белгішесін басыңыз. Уақытты жылдам нұсқалар арқылы немесе күн мен уақытты таңдау терезесінен көрсетіңіз. Белгіленген уақытта хабарландыру шығады.</string>
    <string name="help_reminders_repeat_title">Қайталау параметрлері</string>
    <string name="help_reminders_repeat_description">Жазбаға еске салғыш қойғанда қайталау циклін таңдау үшін «Қайталау» қосқышын қосыңыз: күн сайын, апта сайын немесе ай сайын. Әр хабарландырудан кейін еске салғыш автоматты түрде қайта жоспарланады.</string>
    <string name="help_reminders_interval_title">Аралық хабарландырулар</string>
    <string name="help_reminders_interval_description">Қайталанатын еске салғыштар үшін әр 5, 10, 15, 30 немесе 60 минут сайын қайта хабарлауды қосуға болады. Хабарландыру келесі жоспарланған уақытқа дейін таңдалған аралықпен қайталанады.</string>
    <string name="help_reminders_sound_title">Хабарландыру дыбысы мен қаттылығы</string>
    <string name="help_reminders_sound_description">Еске салғыш әуені мен дыбыс қаттылығын «Параметрлер → Медиа» бөлімінде реттеңіз. Өзгерістер барлық болашақ хабарландыруларға қолданылады.</string>


    <!-- Account tab -->
    <string name="tab_account">Есептік жазба</string>
    <string name="sync_signed_out_title">Сіз кірмегенсіз</string>
    <string name="sync_signed_out_description">Синхрондау және Google Дискідегі көшірме кіргеннен кейін қолжетімді.</string>
    <!-- Sync Help Section -->
    <string name="help_sync_title">Синхрондау</string>
    <string name="help_sync_setup_title">Google Drive-пен синхрондау</string>
    <string name="help_sync_setup_description">Синхрондау міндетті емес. «Есептік жазба» қойындысында Google есептік жазбаңызға кіріп, «Синхрондау» түймесін түртіңіз. Синхрондау өшірілген кезде деректер осы құрылғыда қолжетімді болып қалады.</string>
    <string name="help_sync_first_title">Алғашқы синхрондау</string>
    <string name="help_sync_first_description">Алғашқы синхрондаудың алдында қолданба біріктірілетін жазбалар санын және жүктеудің болжамды көлемін көрсетеді. Ақпаратты тексеріп, бастау үшін растаңыз.</string>
    <string name="help_sync_data_title">Не синхрондалады</string>
    <string name="help_sync_data_description">Жазбалар мен олардың тіркемелері, тапсырмалар, тегтер, тапсырма санаттары және қолданба баптаулары Google Drive-пен синхрондалады.</string>
    <string name="help_sync_background_title">Фондық синхрондау</string>
    <string name="help_sync_background_description">Алғашқы синхрондауды растағаннан кейін фондық синхрондауды қоса аласыз. Ол құрылғы интернетке қосылған кезде шамамен әр 6 сағат сайын орындалады және оны кез келген уақытта өшіруге болады.</string>
    <string name="help_sync_conflicts_title">Қайшылықтарды шешу</string>
    <string name="help_sync_conflicts_description">Жергілікті және Drive нұсқалары әртүрлі болса, әр қайшылық үшін жергілікті нұсқаны не Google Drive нұсқасын сақтауды таңдаңыз.</string>
</resources>
