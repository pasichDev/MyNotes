    <!-- Tags Help Section -->
    <string name="help_tags_title">Etichette</string>
    <string name="help_tags_func_title">Interazione con i tag</string>
    <string name="help_tags_func_description">Nella sezione Tag, puoi creare e modificare i tag. Qui puoi anche gestire l\'ordine dei tag — basta trascinarli per cambiare la disposizione. Questo ti permette di organizzare i tuoi tag in modo efficiente.</string>
    <string name="help_tags_edit_title">Modificare etichette</string>
    <string name="help_tags_edit_description">Tieni premuta un\'etichetta per aprire il menu contestuale di modifica. Qui puoi eliminare l\'etichetta, rinominarla o nascondere le note ad essa associate.</string>
    <string name="help_tags_hide_title">Nascondere note</string>
    <string name="help_tags_hide_description">Usa la funzione di nascondimento per rimuovere temporaneamente le note etichettate dalla vista principale mantenendo l\'accesso tramite l\'etichetta</string>
    <string name="help_tags_limit_title">Limite etichette</string>
    <string name="help_tags_limit_description">Puoi creare fino a 25 etichette per un\'organizzazione efficace delle tue note</string>
    
    <!-- Navigation Help Section -->
    <string name="help_navigation_title">Navigazione</string>
    <string name="help_navigation_drawer_title">Menu principale</string>
    <string name="help_navigation_drawer_description">Accedi al menu principale toccando l\'icona hamburger nell\'angolo in alto a sinistra.</string>
    <string name="help_navigation_search_title">Ricerca</string>
    <string name="help_navigation_search_description">Usa la barra di ricerca per trovare rapidamente le tue note per titolo o contenuto</string>
    <string name="help_navigation_sort_title">Ordinamento</string>
    <string name="help_navigation_sort_description">Ordina le tue note per data dell\'ultima modifica o nome in ordine crescente o decrescente</string>
    <string name="help_navigation_format_title">Formato di visualizzazione</string>
    <string name="help_navigation_format_description">Passa tra lista e griglia per visualizzare le tue note in un layout comodo per te</string>
    
    <!-- Navigation Section - Additional -->
    <string name="help_navigation_swipe_title">Gesti di scorrimento</string>
    <string name="help_navigation_swipe_description">Gestisci le note intuitivamente! Scorri verso sinistra per attivare la modalità di selezione multipla per operazioni di massa rapide, o verso destra per eliminare istantaneamente una nota e inviarla nel cestino. I gesti sono disponibili solo in modalità a colonna singola.</string>
    
    <!-- Other Section -->
    <string name="help_other_title">Altro</string>
    <string name="help_other_security_title">Protezione schermo</string>
    <string name="help_other_security_description">Quando abilitata nelle impostazioni, questa funzione protegge le tue note dalla visualizzazione non autorizzata: nasconde il contenuto dell\'app nella panoramica delle app recenti, impedisce gli screenshot e blocca la registrazione dello schermo. Questa funzione di sicurezza si attiva dopo il riavvio dell\'app.</string>
    <string name="help_other_shortcuts_title">Scorciatoie app</string>
    <string name="help_other_shortcuts_description">Tieni premuta l\'icona dell\'app per accedere rapidamente alle scorciatoie per creare una nuova nota o cercare tra le tue note. Disponibile su Android 7.1 e superiori.</string>
    
    <!-- Help - Notes Features Section -->
    <string name="help_notes_title">Funzionalità note</string>
    <string name="help_notes_limit_title">Limite testo</string>
    <string name="help_notes_limit_description">Ogni nota può contenere fino a 20.000 caratteri, fornendo ampio spazio per contenuti dettagliati.</string>
    <string name="help_notes_translate_title">Traduzione</string>
    <string name="help_notes_translate_description">Traduci le tue note direttamente nell\'app. Google Traduttore deve essere installato sul tuo dispositivo per usare questa funzione.</string>
    <string name="help_notes_text_size_title">Dimensione testo</string>
    <string name="help_notes_text_size_description">Regola la dimensione del testo durante la modifica delle note usando la finestra di dialogo della dimensione del testo accessibile direttamente dalla schermata di modifica della nota.</string>
    <string name="help_notes_copy_title">Modifica copia</string>
    <string name="help_notes_copy_description">Crea una copia modificabile di qualsiasi nota per apportare modifiche mantenendo l\'originale intatto.</string>

