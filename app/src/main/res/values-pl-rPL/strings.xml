    <!-- Tags Help Section -->
    <string name="help_tags_title">Tagi</string>
    <string name="help_tags_func_title">Interakcja z tagami</string>
    <string name="help_tags_func_description">W sekcji Tagi możesz tworzyć i edytować tagi. Możesz także zarządzać ich kolejnością — wystarczy przeciągnąć je, aby zmienić sortowanie. Pozwala to efektywnie organizować Twoje tagi.</string>
    <string name="help_tags_edit_title">Edytowanie tagów</string>
    <string name="help_tags_edit_description">Przytrzymaj tag, aby otworzyć menu kontekstowe edycji. Tutaj możesz usunąć tag, zmienić jego nazwę lub ukryć notatki z nim powiązane.</string>
    <string name="help_tags_hide_title">Ukrywanie notatek</string>
    <string name="help_tags_hide_description">Użyj funkcji ukrywania, aby tymczasowo usunąć oznaczone notatki z głównego widoku, zachowując dostęp do nich przez tag</string>
    <string name="help_tags_limit_title">Limit tagów</string>
    <string name="help_tags_limit_description">Możesz utworzyć do 25 tagów dla efektywnej organizacji swoich notatek</string>

    <!-- Navigation Help Section -->
    <string name="help_navigation_title">Nawigacja</string>
    <string name="help_navigation_drawer_title">Menu główne</string>
    <string name="help_navigation_drawer_description">Uzyskaj dostęp do menu głównego, dotykając ikony hamburgera w lewym górnym rogu.</string>
    <string name="help_navigation_search_title">Wyszukiwanie</string>
    <string name="help_navigation_search_description">Użyj paska wyszukiwania, aby szybko znaleźć swoje notatki według tytułu lub zawartości</string>
    <string name="help_navigation_sort_title">Sortowanie</string>
    <string name="help_navigation_sort_description">Sortuj swoje notatki według daty ostatniej modyfikacji lub nazwy w kolejności rosnącej lub malejącej</string>
    <string name="help_navigation_format_title">Format wyświetlania</string>
    <string name="help_navigation_format_description">Przełączaj między listą a siatką, aby wyświetlać swoje notatki w wygodnym dla siebie układzie</string>

    <!-- Navigation Section - Additional -->
    <string name="help_navigation_swipe_title">Gesty przesuwania</string>
    <string name="help_navigation_swipe_description">Zarządzaj notatkami intuicyjnie! Przesuń w lewo, aby aktywować tryb wielokrotnego wyboru dla szybkich operacji masowych, lub w prawo, aby natychmiast usunąć notatkę i wysłać ją do kosza. Gesty są dostępne tylko w trybie jednokolumnowym.</string>

    <!-- Other Section -->
    <string name="help_other_title">Inne</string>
    <string name="help_other_security_title">Ochrona ekranu</string>
    <string name="help_other_security_description">Po włączeniu w ustawieniach, ta funkcja chroni twoje notatki przed nieautoryzowanym przeglądaniem: ukrywa zawartość aplikacji w przeglądzie ostatnich aplikacji, zapobiega zrzutom ekranu i blokuje nagrywanie ekranu. Ta funkcja bezpieczeństwa aktywuje się po ponownym uruchomieniu aplikacji.</string>
    <string name="help_other_shortcuts_title">Skróty aplikacji</string>
    <string name="help_other_shortcuts_description">Przytrzymaj ikonę aplikacji, aby szybko uzyskać dostęp do skrótów tworzenia nowej notatki lub wyszukiwania w twoich notatkach. Dostępne na Androidzie 7.1 i wyższym.</string>

    <!-- Help - Notes Features Section -->
    <string name="help_notes_title">Funkcje notatek</string>
    <string name="help_notes_limit_title">Limit tekstu</string>
    <string name="help_notes_limit_description">Każda notatka może zawierać do 20 000 znaków, zapewniając wystarczająco miejsca na szczegółową zawartość.</string>
    <string name="help_notes_translate_title">Tłumaczenie</string>
    <string name="help_notes_translate_description">Tłumacz swoje notatki bezpośrednio w aplikacji. Tłumacz Google musi być zainstalowany na twoim urządzeniu, aby korzystać z tej funkcji.</string>
    <string name="help_notes_text_size_title">Rozmiar tekstu</string>
    <string name="help_notes_text_size_description">Dostosuj rozmiar tekstu podczas edytowania notatek za pomocą okna dialogowego rozmiaru tekstu dostępnego bezpośrednio z ekranu edycji notatki.</string>
    <string name="help_notes_copy_title">Edytuj kopię</string>
    <string name="help_notes_copy_description">Utwórz edytowalną kopię dowolnej notatki, aby wprowadzić zmiany, zachowując oryginalną w nienaruszonym stanie.</string>

