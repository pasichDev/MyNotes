<?xml version="1.0" encoding="utf-8"?>
<!--
    Правила резервного копіювання для Android 9+ (API 28+)
    З підтримкою зашифрованого резервного копіювання
-->
<full-backup-content>
    <!-- Включити базу даних із підтримкою шифрування -->
    <include domain="database" path="." requireFlags="clientSideEncryption" />
    
    <!-- Включити налаштування із шифруванням -->
    <include domain="sharedpref" path="." requireFlags="clientSideEncryption" />
    
    <!-- Включити файли додатку -->
    <include domain="file" path="." />
    
    <!-- Включити зовнішні файли -->
    <include domain="external" path="." />
    
    <!-- Специфічні включення для нотаток -->
    <include domain="file" path="encrypted_notes/" requireFlags="clientSideEncryption" />
    <include domain="file" path="secure_attachments/" requireFlags="clientSideEncryption" />
    <include domain="file" path="user_backups/" />
    
    <!-- Включення налаштувань безпеки -->
    <include domain="sharedpref" path="security_preferences.xml" requireFlags="clientSideEncryption" />
    <include domain="sharedpref" path="encryption_settings.xml" requireFlags="clientSideEncryption" />
    
    <!-- Виключення небезпечних файлів -->
    <exclude domain="file" path="cache/" />
    <exclude domain="file" path="code_cache/" />
    <exclude domain="file" path="temp/" />
    <exclude domain="file" path="no_backup/" />
    <exclude domain="file" path="sensitive_cache/" />
    
    <!-- Виключення файлів діагностики -->
    <exclude domain="file" path="logs/" />
    <exclude domain="file" path="crash_logs/" />
    <exclude domain="file" path="debug_logs/" />
    <exclude domain="file" path="performance_data/" />
    
    <!-- Виключення конфіденційних налаштувань -->
    <exclude domain="sharedpref" path="device_fingerprint.xml" />
    <exclude domain="sharedpref" path="hardware_data.xml" />
    <exclude domain="sharedpref" path="analytics_tokens.xml" />
    
    <!-- Виключення зовнішніх тимчасових файлів -->
    <exclude domain="external" path="Android/data/com.pasich.mynotes/cache/" />
    <exclude domain="external" path="Android/data/com.pasich.mynotes/files/temp/" />
    <exclude domain="external" path="Android/data/com.pasich.mynotes/files/logs/" />
    
    <!-- Включення важливих зовнішніх файлів -->
    <include domain="external" path="MyNotes/backups/" />
    <include domain="external" path="MyNotes/exports/" />
    <include domain="external" path="Documents/MyNotes/" />
</full-backup-content>
