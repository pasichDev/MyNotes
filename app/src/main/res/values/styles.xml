<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- res/values/styles.xml -->
    <style name="ShapeAppearance.BottomBar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Navigation Drawer styles -->
    <style name="NavigationViewStyle" parent="Widget.Material3.NavigationView">
        <item name="android:layout_gravity">start</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="itemTextAppearance">@style/NavigationViewTextAppearance</item>
        <item name="itemIconTint">?attr/colorPrimary</item>
        <item name="itemTextColor">?attr/colorOnSurface</item>
        <item name="itemHorizontalPadding">16dp</item>
        <item name="itemVerticalPadding">12dp</item>
        <item name="itemIconPadding">32dp</item>
        <item name="itemMinHeight">56dp</item>
        <item name="android:background">?attr/colorSurface</item>
        <item name="elevation">0dp</item>
        <item name="itemShapeAppearance">@style/NavigationItemShapeAppearance</item>
        <item name="itemShapeInsetStart">12dp</item>
        <item name="itemShapeInsetEnd">12dp</item>
        <item name="itemShapeInsetTop">4dp</item>
        <item name="itemShapeInsetBottom">4dp</item>
    </style>

    <style name="NavigationViewTextAppearance" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">@font/ptsans_regular</item>
    </style>

    <style name="NavigationItemShapeAppearance" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
    <!-- Toolbar title style -->


    <style name="fab_custom" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="android:backgroundTint">?attr/colorPrimary</item>
        <item name="tint">?attr/colorOnPrimary</item>
        <item name="android:layout_marginBottom">15dp</item>
        <item name="android:layout_marginEnd">20dp</item>
        <item name="elevation">7dp</item>
    </style>

    <!-- Стиль для параграфа -->

    <!-- Позиционирование елементов в BottomSheetsDialog -->
    <style name="marginDialogItem">
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_marginEnd">12dp</item>
    </style>

    <!-- Стиль иконок в BottomSheetsDialog -->
    <style name="iconDialogList">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:background">@null</item>
        <item name="android:tint">?android:colorPrimary</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:layout_gravity">center_vertical</item>
    </style>

    <!-- Стиль иконок в Activity -->
    <style name="iconActivityList">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:background">@null</item>
        <item name="android:tint">?android:colorPrimary</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginEnd">20dp</item>
        <item name="android:layout_gravity">center_vertical</item>
    </style>

    <!-- Стиль иконок в ActionPanel -->

    <style name="bottomSheetInput" parent="@style/ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>


    <style name="itemNoteTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:layout_marginBottom">3dp</item>
        <item name="android:fontFamily">@font/ptsans_regular</item>
        <item name="android:maxLines">@integer/countLinesNoteTitle</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="itemNotePreview">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:layout_marginBottom">3dp</item>
        <item name="android:maxLines">@integer/maxLinesItemNoteValue</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="itemTextBottomSheets" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:padding">@dimen/paddingItems</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="rounderIconApp">
        <item name="cornerSize">10%</item>
    </style>

    <style name="circleUserAvatar">
        <item name="cornerSize">50%</item>
    </style>

    <style name="progressDialogRestore" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:windowCloseOnTouchOutside">false</item>
    </style>


    <style name="chipTagItemNote" parent="@style/Widget.Material3.Chip.Assist">
        <item name="android:enabled">false</item>
        <item name="chipCornerRadius">@dimen/defaultCornerChip</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="chipBackgroundColor">?attr/colorSurfaceVariant</item>
    </style>

    <style name="chipTagDialog" parent="@style/Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">@dimen/defaultCornerChip</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="chipBackgroundColor">?attr/colorSurfaceVariant</item>
    </style>

    <style name="iconActivityListBackup">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:background">@null</item>
        <item name="android:tint">?android:colorPrimary</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:layout_gravity">center_vertical</item>
    </style>

</resources>