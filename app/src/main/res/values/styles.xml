<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Navigation Drawer styles -->
    <style name="NavigationViewStyle" parent="Widget.MaterialComponents.NavigationView">
        <item name="android:layout_gravity">start</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="itemTextAppearance">@style/NavigationViewTextAppearance</item>
        <item name="itemIconTint">?attr/colorPrimary</item>
        <item name="itemTextColor">?attr/colorOnSurface</item>
        <item name="itemBackground">@drawable/nav_item_background</item>
        <item name="itemHorizontalPadding">5dp</item>
        <item name="itemVerticalPadding">12dp</item>
        <item name="itemIconPadding">24dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>

    </style>

    <style name="NavigationViewTextAppearance" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
    </style>
</resources>