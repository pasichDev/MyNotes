    <string name="support_solo_developer_title">Support Developer</string>
    <string name="support_solo_developer_description">Hi! I\'m a developer working on MyNotes in my free time. All features will always be free, but your support helps me dedicate more time to making this app even better. Every contribution means the world to me! 💖</string>

    <!-- Help Activity -->
    <string name="help_title">Help</string>
    <string name="help_subtitle">Learn how to get the most out of MyNotes features</string>
    <string name="help_section_icon">Section icon</string>
    <string name="help_feature_icon">Feature icon</string>

    <!-- Tags Help Section -->
    <string name="help_tags_title">Tags</string>
    <string name="help_tags_edit_title">Editing Tags</string>
    <string name="help_tags_edit_description">Hold a tag to open the context menu. Here you can delete the tag, rename it, or hide notes associated with it.</string>
    <string name="help_tags_hide_title">Hiding Notes</string>
    <string name="help_tags_hide_description">Use the hide function to temporarily remove tagged notes from the main view while keeping access to them through the tag</string>
    <string name="help_tags_limit_title">Tag Limit</string>
    <string name="help_tags_limit_description">You can create up to 25 tags for effective organization of your notes</string>
    <string name="help_tags_func_title">Interaction with tags</string>
    <string name="help_tags_func_description">In the Tags section, you can create and edit tags. You can also manage the order of tags here — simply drag and drop them to change the sorting. This allows you to organize your tags efficiently.</string>

    <!-- Navigation Help Section -->
    <string name="help_navigation_title">Navigation</string>
    <string name="help_navigation_drawer_title">Main Menu</string>
    <string name="help_navigation_drawer_description">Access the main menu by tapping the hamburger icon in the top left corner.</string>
    <string name="help_navigation_search_title">Search</string>
    <string name="help_navigation_search_description">Use the search bar to quickly find your notes by title or content</string>
    <string name="help_navigation_sort_title">Sorting</string>
    <string name="help_navigation_sort_description">Sort your notes by last modified date or name in ascending or descending order</string>
    <string name="help_navigation_format_title">Display Format</string>
    <string name="help_navigation_format_description">Switch between list and grid to display your notes in a layout convenient for you</string>

    <!-- Navigation Section - Additional -->
    <string name="help_navigation_swipe_title">Swipe Gestures</string>
    <string name="help_navigation_swipe_description">Manage notes intuitively! Swipe left to activate multiple note selection mode for quick bulk operations, or swipe right to instantly delete a note and send it to trash. Gestures are only available in single-column mode.</string>

    <!-- Other Section -->
    <string name="help_other_title">Other</string>
    <string name="help_other_security_title">Screen Protection</string>
    <string name="help_other_security_description">When enabled in settings, this feature protects your notes from unauthorized viewing by hiding app content in recent apps overview, preventing screenshots, and blocking screen recording. This security feature activates after restarting the app.</string>
    <string name="help_other_shortcuts_title">App Shortcuts</string>
    <string name="help_other_shortcuts_description">Long press the app icon to quickly access shortcuts for creating a new note or searching through your notes. Available on Android 7.1 and higher.</string>

    <!-- Backup and Export Help -->
    <string name="help_other_backup_export_title">Sync and Data Export</string>
    <string name="help_other_backup_export_description">In the Synchronization and Backup section, you can export all your notes in various formats (TXT, PDF, HTML) for viewing and backup purposes.</string>

    <!-- Help - Notes Features Section -->
    <string name="help_notes_title">Notes Features</string>
    <string name="help_notes_limit_title">Text Limit</string>
    <string name="help_notes_limit_description">Each note can contain up to 20,000 characters, providing ample space for detailed content.</string>
    <string name="help_notes_translate_title">Translation</string>
    <string name="help_notes_translate_description">Translate your notes directly within the app. Google Translate must be installed on your device to use this feature.</string>
    <string name="help_notes_text_size_title">Text Size</string>
    <string name="help_notes_text_size_description">Adjust text size while editing notes using the text size dialog accessible directly from the note editing screen.</string>
    <string name="help_notes_copy_title">Edit Copy</string>
    <string name="help_notes_copy_description">Create an editable copy of any note to make modifications while keeping the original intact.</string>

    <!-- Share and Export Help -->
    <string name="help_notes_share_title">Share and Export Notes</string>
    <string name="help_notes_share_description">Share single or multiple notes via other apps, save to Google Drive, or export as TXT, PDF, or HTML files with styled formatting.</string>

    <!-- Auto-save Help -->
    <string name="help_notes_autosave_title">Auto-save</string>
    <string name="help_notes_autosave_description">Notes are automatically saved 2 seconds after you stop typing. A status indicator in the top bar shows: blue dot for unsaved changes, animated icon for saving in progress, green checkmark for successfully saved. Even if you close the app or it crashes, your latest changes won\'t be lost.</string>

