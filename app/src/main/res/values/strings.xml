    <!-- Meet Encly (pasichDev/MyNotes#167) -->
    <string name="meet_encly_title">Meet Encly</string>
    <string name="meet_encly_drawer_subtitle">The successor of My Notes</string>
    <string name="meet_encly_intro">Encly is the next app from the author of My Notes: a fully encrypted notes app that works offline. Your notes live in an encrypted database, the app locks with a PIN, and backups are encrypted too.</string>
    <string name="meet_encly_one_way">Moving is one way: My Notes hands your data to Encly, and Encly never sends anything back. Nothing is deleted from My Notes; it keeps working as before.</string>
    <string name="meet_encly_moves_title">What moves</string>
    <string name="meet_encly_moves_notes">Notes, including the trash: %1$d</string>
    <string name="meet_encly_moves_tasks">Tasks: %1$d</string>
    <string name="meet_encly_moves_tags">Tags: %1$d</string>
    <string name="meet_encly_moves_categories">Task lists (they become tags): %1$d</string>
    <string name="meet_encly_stays_title">What does not move</string>
    <string name="meet_encly_stays_attachments">Attachments and images: %1$d. They stay in My Notes.</string>
    <string name="meet_encly_stays_reminders">Reminders: %1$d. Encly has no reminders.</string>
    <string name="meet_encly_stays_pinned">Pinned notes: %1$d. They move, but without the pin.</string>
    <string name="meet_encly_get">Get Encly</string>
    <string name="meet_encly_update">Update Encly</string>
