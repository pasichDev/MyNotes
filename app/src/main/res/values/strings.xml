    <string name="meet_encly_clear_confirm_title">Clear My Notes?</string>
    <string name="meet_encly_clear_confirm_message">This permanently deletes all notes (including the trash), tasks, tags, task lists and attachment files from My Notes. If Google Drive sync is on, they are deleted from the synced copy too. Attachments did not move to Encly. This cannot be undone.</string>
