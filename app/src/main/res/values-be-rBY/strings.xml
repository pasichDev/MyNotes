    <!-- Developer Support -->
    <string name="support_solo_developer_title">Падтрымаць распрацоўшчыка</string>
    <string name="support_solo_developer_description">Прывітанне! Я распрацоўшчык, які працуе над MyNotes у свабодны час. Усе функцыі заўсёды будуць бясплатнымі, але ваша падтрымка дапамагае мне прысвячаць больш часу паляпшэнню гэтага прыкладання. Кожны ўнёсак азначае для мяне ўвесь свет! 💖</string>

    <!-- Help Activity -->
    <string name="help_title">Даведка</string>
    <string name="help_subtitle">Даведайцеся, як максімальна выкарыстоўваць функцыі MyNotes</string>
    <string name="help_section_icon">Іконка раздзела</string>
    <string name="help_feature_icon">Іконка функцыі</string>
    
    <!-- Tags Help Section -->
    <string name="help_tags_title">Тэгі</string>
    <string name="help_tags_func_title">Узаемадзеянне з тэгаў</string>
    <string name="help_tags_func_description">У раздзеле Тэгі вы можаце ствараць і рэдагаваць тэгі. Тут таксама можна кіраваць парадкам тэгаў — проста перацягніце іх, каб змяніць сартаванне. Гэта дазваляе эфектыўна арганізоўваць вашыя тэгі.</string>
    <string name="help_tags_edit_title">Рэдагаванне тэгаў</string>
    <string name="help_tags_edit_description">Утрымлівайце тэг, каб адкрыць кантэкстнае меню рэдагавання. Тут вы можаце выдаліць тэг, перайменаваць яго або схаваць нататкі, звязаныя з ім.</string>
    <string name="help_tags_hide_title">Схаванне нататак</string>
    <string name="help_tags_hide_description">Выкарыстоўвайце функцыю схавання, каб часова выдаліць пазначаныя нататкі з галоўнага выгляду, захоўваючы доступ да іх праз тэг</string>
    <string name="help_tags_limit_title">Абмежаванне тэгаў</string>
    <string name="help_tags_limit_description">Можна стварыць не больш за 25 тэгаў для эфектыўнай арганізацыі вашых нататак</string>

    <!-- Navigation Help Section -->
    <string name="help_navigation_title">Навігацыя</string>
    <string name="help_navigation_drawer_title">Галоўнае меню</string>
    <string name="help_navigation_drawer_description">Атрымайце доступ да галоўнага меню, націснуўшы іконку бургера ў верхнім левым куце.</string>
    <string name="help_navigation_search_title">Пошук</string>
    <string name="help_navigation_search_description">Выкарыстоўвайце панэль пошуку для хуткага знаходжання вашых нататак па назве або змесце</string>
    <string name="help_navigation_sort_title">Сартаванне</string>
    <string name="help_navigation_sort_description">Сартуйце вашы нататкі па даце апошняй змены або назве ў ўзыходным ці спадным парадку</string>
    <string name="help_navigation_format_title">Фармат адлюстравання</string>
    <string name="help_navigation_format_description">Пераключайцеся паміж спісам і сеткай для адлюстравання вашых нататак у зручным для вас макеце</string>
    
    <!-- Navigation Section - Additional -->
    <string name="help_navigation_swipe_title">Жэсты свайп</string>
    <string name="help_navigation_swipe_description">Кіруйце нататкамі інтуітыўна! Правядзіце пальцам улева, каб уключыць рэжым выбару некалькіх нататак для хуткіх масавых аперацый, або ўправа — каб імгненна выдаліць нататку і адправіць яе ў кош. Жэсты даступны толькі ў адноколонкавым рэжыме.</string>
    
    <!-- Other Section -->
    <string name="help_other_title">Іншае</string>
    <string name="help_other_security_title">Абарона экрана</string>
    <string name="help_other_security_description">Калі ўключана ў наладах, гэтая функцыя абараняе вашы нататкі ад несанкцыянаванага прагляду: хавае змесціва прыкладання ў агляды апошніх прыкладанняў, забараняе стварэнне скрыншотаў і запіс экрана. Функцыя бяспекі актывуецца пасля перазапуску прыкладання.</string>
    <string name="help_other_shortcuts_title">Хуткія дзеянні</string>
    <string name="help_other_shortcuts_description">Утрымлівайце іконку прыкладання для хуткага доступу да стварэння новай нататкі або пошуку ў вашых нататках. Даступна на Android 7.1 і вышэй.</string>
    
    <!-- Help - Notes Features Section -->
    <string name="help_notes_title">Функцыі нататак</string>
    <string name="help_notes_limit_title">Абмежаванне тэксту</string>
    <string name="help_notes_limit_description">Кожная нататка можа ўтрымліваць да 20,000 сімвалаў, што забяспечвае дастаткова месца для дэтальнага змесціва.</string>
    <string name="help_notes_translate_title">Пераклад</string>
    <string name="help_notes_translate_description">Перакладайце вашы нататкі прама ў прыкладанні. Для выкарыстання гэтай функцыі на вашай прыладзе павінен быць усталяваны Google Перакладчык.</string>
    <string name="help_notes_text_size_title">Памер тэксту</string>
    <string name="help_notes_text_size_description">Змяняйце памер тэксту падчас рэдагавання нататак з дапамогай дыялогавага акна памеру тэксту, даступнага прама з экрана рэдагавання нататкі.</string>
    <string name="help_notes_copy_title">Рэдагаваць копію</string>
    <string name="help_notes_copy_description">Ствараць рэдагавальную копію любой нататкі для ўнясення змен, захоўваючы арыгінал недакрануты.</string>
    <string name="save_to_notes">Захаваць у Мае Нататкі</string>
    <string name="actual_version">Актуальна для версіі %1$s</string>
    <!-- Backup and Export Help -->
    <string name="help_other_backup_export_title">Сінхранізацыя і экспарт даных</string>
    <string name="help_other_backup_export_description">У раздзеле «Сінхранізацыя і рэзервовае капіраванне» вы можаце экспартаваць усе свае нататкі ў розных фарматах (TXT, PDF, HTML) для прагляду і рэзервовага капіравання.</string>

